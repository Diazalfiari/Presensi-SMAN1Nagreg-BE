# ==============================================================================
# ENVIRONMENT CONFIGURATION: SISTEM PRESENSI SMAN 1 NAGREG
# ==============================================================================

# Application Port & Mode (Railway otomatis mengatur PORT)
PORT=5000
NODE_ENV=production

# Frontend URL (CORS Origin) - Masukkan URL Vercel Anda (pisahkan koma jika lebih dari satu)
# Contoh: https://presensi-sman1nagreg.vercel.app,http://localhost:3000
CLIENT_URL=https://presensi-sman1nagreg.vercel.app

# Database MySQL Configuration
# OPSI A: Jika menggunakan Railway MySQL Plugin (variabel ini otomatis terisi di Railway)
# MYSQLHOST=
# MYSQLPORT=
# MYSQLUSER=
# MYSQLPASSWORD=
# MYSQLDATABASE=
# MYSQL_URL=

# OPSI B: Konfigurasi manual
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=db_presensi_sman1nagreg
DB_SSL=false

# JSON Web Token Secret (Wajib diganti dengan string acak yang aman di production)
JWT_SECRET=super_secret_jwt_key_sman1nagreg_2026_secure_random_string
JWT_EXPIRES_IN=1d

# Upload Configuration (Maksimum 10MB)
MAX_FILE_SIZE=10485760

